xrdb ~/.Xresources

# Make GUI/session variables available to D-Bus/systemd activated services.
# Required for xdg-desktop-portal-gtk file chooser dialogs under startx/dwm.
export XDG_CURRENT_DESKTOP=dwm
export XDG_SESSION_TYPE=x11
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS

setxkbmap -layout us -variant intl -option "caps:escape"

xcape -e 'Super_L=Super_L|Shift_L|d' &

TOUCHPAD_ID=$(xinput list --id-only "DELL07E6:00 06CB:76AF Touchpad")
xinput set-prop "$TOUCHPAD_ID" "libinput Natural Scrolling Enabled" 1
xinput set-prop "$TOUCHPAD_ID" "libinput Tapping Enabled" 1

xrandr --output eDP-1 --mode 1280x720 --output DP-2 --off

xss-lock -- xsecurelock &
export CM_DIR="$HOME/.local/share/clipmenu"
clipmenud &
dunst &
feh --bg-scale Pictures/wallpapers/wallpaper &
tmux-sessions home &
slstatus &
starthandy &
