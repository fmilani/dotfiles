#!/bin/sh

# Machine-readable provider records: source<TAB>label<TAB>value.
list_records() {
  printf 'power\tPower off\tpoweroff\n'
  printf 'power\tSuspend\tsuspend\n'
  printf 'power\tReboot\treboot\n'
}

run_action() {
  case "${1:-}" in
    poweroff) systemctl poweroff ;;
    suspend) systemctl suspend ;;
    reboot) systemctl reboot ;;
  esac
}

open_menu() {
  chosen=$(printf 'Power off\nSuspend\nReboot\n' | dmenu -i -p "Power options")

  case "$chosen" in
    "Power off") run_action poweroff ;;
    "Suspend") run_action suspend ;;
    "Reboot") run_action reboot ;;
  esac
}

case "${1:-}" in
  --list) list_records ;;
  --open) run_action "${2:-}" ;;
  *) open_menu ;;
esac
