#!/bin/bash

TMUX_SESSION_DIR="$HOME/.local/bin/tmux"

list_choices() {
  local -A open_names=()
  local choice template name

  while IFS= read -r choice; do
    [[ -n "$choice" ]] || continue
    printf '%s\n' "$choice"
    open_names["${choice%%:*}"]=1
  done < <(tmux list-windows -a -F '#S:#W' 2>/dev/null)

  shopt -s nullglob
  for template in "$TMUX_SESSION_DIR"/*; do
    [[ -f "$template" ]] || continue
    name=${template##*/}
    [[ -v "open_names[$name]" ]] || printf '%s\n' "$name"
  done
  shopt -u nullglob
}

# Machine-readable provider records: source<TAB>label<TAB>value.
list_records() {
  local choice

  while IFS= read -r choice; do
    [[ -n "$choice" ]] || continue
    printf 'tmux\t%s\t%s\n' "$choice" "$choice"
  done < <(list_choices | sort -u)
}

open_session() {
  local target=${1:-}
  local session_name template

  [[ -n "$target" ]] || return 0
  session_name=${target%%:*}

  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    template="$TMUX_SESSION_DIR/$target"
    if [[ ! -x "$template" ]]; then
      printf 'No tmux session or template named %s.\n' "$target" >&2
      return 1
    fi
    "$template"
  fi

  if wmctrl -xa tmux 2>/dev/null; then
    tmux switch-client -t "$target"
  else
    coproc { exec ghostty --x11-instance-name=tmux -e tmux attach-session -t "$target"; }
  fi
}

open_menu() {
  local target

  target=$(list_choices | sort -u | dmenu -i -p "Open tmux session")
  [[ -n "$target" ]] || return 0
  open_session "$target"
}

case ${1:-} in
  --list) list_records ;;
  --open) open_session "${2:-}" ;;
  '') open_menu ;;
  *) open_session "$1" ;;
esac
