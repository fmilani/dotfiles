#!/bin/bash

battery=/sys/class/power_supply/BAT0
[[ -r "$battery/status" && -r "$battery/capacity" ]] || exit 0

status=$(<"$battery/status")
capacity=$(<"$battery/capacity")

# Hide the block when TLP has paused charging or the battery is full.
case "$status" in
  Charging|Discharging) ;;
  *) exit 0 ;;
esac

# Material Design battery glyphs from JetBrains Mono Nerd Font, 0–100%.
normal_icons=(󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)
charging_icons=(󰢟 󰢜 󰂆 󰂇 󰂈 󰢝 󰂉 󰢞 󰂊 󰂋 󰂅)

level=$(((capacity + 5) / 10))
((level > 10)) && level=10

if [[ "$status" == "Charging" ]]; then
  icon=${charging_icons[level]}
else
  icon=${normal_icons[level]}
fi

printf '%s %s%%\n' "$icon" "$capacity"
